# Copy to .env and fill in your values. Never commit .env.

# Flask
FLASK_APP=sycometrix
SECRET_KEY=dev-only-change-me

# Database (matches docker-compose.yml). If another PostgreSQL already uses port 5432,
# set POSTGRES_PORT to a free port (e.g. 5433) and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sycometrix:sycometrix@localhost:5432/sycometrix
# Tests use in-memory SQLite unless this is set
# TEST_DATABASE_URL=

# LLM provider: "openrouter" or "fake"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Defaults to DEFAULT_MODEL when unset
JUDGE_MODEL=
DEFAULT_TEMPERATURE=0.0
MAX_RESPONSE_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
